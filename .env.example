# Reown (WalletConnect) project id — create one at https://dashboard.reown.com
VITE_PROJECT_ID="<string>"

# App environment: controls the list of supported chains
# development -> localhost fork + Arbitrum Sepolia
# production  -> Arbitrum One + Arbitrum Sepolia
VITE_ENV="<development | production>"

# Backend API base URL (admin panel, greetings)
VITE_BACKEND_URL="<string?>"

# The Graph endpoints
VITE_GRAPH_URL="<string?>"
VITE_GRAPH_URL_STATS="<string?>"
VITE_GRAPH_URL_REFERRALS="<string?>"

# Domain bound into the wallet-signed auth message; must match the backend
VITE_AUTH_DOMAIN="<string?>"

# Show game results immediately (debugging aid)
VITE_EXPERIMENTAL_SHOW_RESULT="<true | false>"

# Sentry (optional): error reporting DSN, org/project and source-map upload token
VITE_SENTRY_DSN="<string?>"
SENTRY_AUTH_TOKEN="<string?>"
SENTRY_ORG="<string?>"
SENTRY_PROJECT="<string?>"
